{
  "name": "@deepseek-ai/dsh-learning-classroom",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "课堂式个人学习：知识文件库、学习空间与四区课堂骨架",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.27",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "dsh": "0.2.1-rc.3"
  }
}

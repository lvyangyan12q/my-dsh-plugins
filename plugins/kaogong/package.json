{
  "name": "@deepseek-ai/dsh-tool-kaogong",
  "description": "武汉公务员考试学习套件：错题本（归纳问题点/总结）+ 倒排学习计划与进度",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.mjs",
    "lib/**/*.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "src",
    "题目_images/verified",
    "roles",
    "data",
    "scripts",
    "tests",
    "README.md",
    "tsconfig.json",
    "tsconfig.client.json",
    "tsdown.config.ts",
    "tsdown.host.config.ts",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsdown -c tsdown.host.config.ts",
    "build:client": "tsdown -c tsdown.config.ts && tsc -p tsconfig.client.json",
    "test:artifact": "node --test tests/views.test.mjs tests/package.test.mjs",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit --emitDeclarationOnly false",
    "prepare": "pnpm run build"
  },
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-persona": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-personal-workbench": "file:../personal-workbench",
    "@types/react": "~18.3.1",
    "@types/node": "^24.0.0",
    "react": "^18.2.0",
    "lucide-react": "0.468.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-personal-workbench": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-personal-workbench": { "optional": true }
  }
}

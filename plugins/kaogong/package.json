{
  "name": "@deepseek-ai/dsh-tool-kaogong",
  "description": "武汉公务员考试学习套件：错题本（归纳问题点/总结）+ 倒排学习计划与进度",
  "version": "0.3.0-rc.3.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.mjs",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.mts",
    "cordis.patch.yml",
    "roles/personas/老师.md",
    "roles/personas/班主任.md",
    "roles/personas/辅导员.md",
    "roles/skills/kaogong-teach/SKILL.md",
    "data/sample-bank.json",
    "data/sample-knowledge.json",
    "data/sample-questions.json",
    "README.md",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "layout",
        "uiWorkspace",
        "sidebarRight",
        "sidebarRightTabs"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build.mjs --host",
    "build:client": "node scripts/build.mjs --client",
    "build:types": "node scripts/check-host-types.mjs --emit",
    "test:artifact": "node --test tests/package.test.mjs",
    "test": "node scripts/test-current.mjs",
    "test:practice": "node scripts/test-current.mjs --domain",
    "test:runtime": "node scripts/test-current.mjs --host",
    "typecheck:client": "node scripts/check-client-types.mjs",
    "typecheck:host": "node scripts/check-host-types.mjs",
    "test:platform": "node scripts/test-current.mjs",
    "pack": "node scripts/pack-release.mjs",
    "test:domain": "node scripts/test-current.mjs --domain",
    "test:host": "node scripts/test-current.mjs --host",
    "test:client": "node scripts/test-current.mjs --client"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.14",
    "get-tsconfig": "5.0.0-beta.5",
    "marked": "^18.0.11",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-persona": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@types/react": "~18.3.1",
    "@types/node": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "29.1.1",
    "tsx": "^4.20.0",
    "lucide-react": "0.468.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3"
  }
}

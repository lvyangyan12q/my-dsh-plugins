{
  "name": "@deepseek-ai/dsh-tool-kaogong",
  "description": "武汉公务员考试学习套件：错题本（归纳问题点/总结）+ 倒排学习计划与进度",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.mjs",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "题目_images/verified/资料600-2023-hebei-retail-growth.png",
    "题目_images/verified/资料600-2024-jiangsu-17.png",
    "roles/personas/老师.md",
    "roles/personas/班主任.md",
    "roles/personas/辅导员.md",
    "roles/skills/kaogong-teach/SKILL.md",
    "data/sample-bank.json",
    "data/sample-knowledge.json",
    "data/sample-questions.json",
    "README.md",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-personal-workbench"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client && pnpm run build:types",
    "build:host": "tsdown -c tsdown.host.config.ts",
    "build:client": "tsdown -c tsdown.config.ts && tsc -p tsconfig.client.json",
    "build:types": "tsc -p tsconfig.host.json",
    "test:artifact": "node --test tests/views.test.mjs tests/package.test.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:practice": "tsx --test tests/practice-rounds.test.mjs tests/views.test.mjs",
    "test:runtime": "tsx scripts/check-practice-runtime.mjs",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit --emitDeclarationOnly false",
    "typecheck:host": "tsc -p tsconfig.host.json --noEmit --emitDeclarationOnly false",
    "test:platform": "tsx --test tests/platform-integration.test.mjs tests/views.test.mjs tests/practice-rounds.test.mjs tests/lessons.test.mjs tests/role-presets.test.mjs tests/runtime-compat.test.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-persona": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-personal-workbench": "0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-personal-workbench": "file:../personal-workbench",
    "@types/react": "~18.3.1",
    "@types/node": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "29.1.1",
    "tsx": "^4.20.0",
    "lucide-react": "0.468.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2"
  }
}

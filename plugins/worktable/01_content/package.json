{
  "name": "dsh-worktable",
  "description": "工作台 Worktable：DeepSeek Harness 侧边栏的 agent 级项目容器（应用抽屉）",
  "version": "0.10.0-rc.3.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aisland-SJL/dsh-worktable.git",
    "directory": "01_content"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.3"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./sdk": {
      "types": "./lib/sdk.d.ts",
      "import": "./lib/sdk.js",
      "default": "./lib/sdk.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "lib/sdk.js",
    "lib/sdk.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test:layout": "node --test ../04_test/custom-task.test.mjs ../04_test/split-resize.test.mjs ../04_test/split-minimize.test.mjs ../04_test/split-region-minimize.test.mjs ../04_test/project-layout.test.mjs ../04_test/project-layout-http.test.mjs ../04_test/project-layout-client.test.mjs ../04_test/project-layout-cli.test.mjs ../04_test/project-layout-actions.test.mjs ../04_test/terminal-start.test.mjs ../04_test/annotation-target.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "pack": "node release-prep.mjs",
    "test:gate": "node client-factory-gate.test.mjs",
    "test:input": "node ../04_test/host-input.test.mjs",
    "test:session": "node ../04_test/session-compat.test.mjs",
    "test:details": "node ../04_test/session-details.test.mjs",
    "test:transport": "node ../04_test/host-transport.test.mjs",
    "test:widget": "node ../04_test/widget-mount.test.mjs",
    "verify:remote": "node verify-remote.mjs",
    "test:roles": "node --test ../04_test/roles.test.mjs ../04_test/capabilities.test.mjs ../04_test/role-native.test.mjs ../04_test/role-panel.test.mjs ../04_test/capability-native.test.mjs ../04_test/role-lifecycle.test.mjs ../04_test/role-navigation.test.mjs",
    "test:applications": "node --test ../04_test/application-entry.test.mjs ../04_test/application-http.test.mjs ../04_test/application-component.test.mjs ../04_test/directory-refresh.test.mjs",
    "test:tasks": "node --test ../04_test/tasks.test.mjs ../04_test/task-host.test.mjs ../04_test/task-panel.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "xterm": "^5.3.0",
    "react-dom": "18.3.1",
    "jsdom": "^29.1.1"
  }
}

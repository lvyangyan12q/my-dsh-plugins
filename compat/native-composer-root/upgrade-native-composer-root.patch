+
+it('does not retain the previous view composition watcher during root handoff', () => {
+  const main = bench()
+  render(<InputBar {...main.props} />)
+  const live = new Set<EventListenerOrEventListenerObject>()
+  const originalAdd = main.textarea.addEventListener.bind(main.textarea)
+  const originalRemove = main.textarea.removeEventListener.bind(main.textarea)
+  const add = vi.spyOn(main.textarea, 'addEventListener').mockImplementation((name, listener, options) => {
+    if (name === 'compositionstart') live.add(listener)
+    originalAdd(name, listener, options)
+  })
+  const remove = vi.spyOn(main.textarea, 'removeEventListener').mockImplementation((name, listener, options) => {
+    if (name === 'compositionstart') live.delete(listener)
+    originalRemove(name, listener, options)
+  })
+  onTestFinished(() => { add.mockRestore(); remove.mockRestore() })
+  act(() => { main.textarea.focus() })
+  // addEventListener may be invoked twice with the same callback. Count live
+  // identities after removals, as the browser does, rather than registrations.
+  expect(live.size).toBe(2)
+})

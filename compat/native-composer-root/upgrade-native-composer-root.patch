+    expect(appRoot.textContent).toBe('')
+  })
+
+  it('routes clipboard intake and file dialogs only through the active view', () => {
+    const intakeMain = vi.fn(() => null)
+    const intakeApp = vi.fn(() => null)
+    const main = bench({ addFiles: intakeMain })
+    const app = render(<InputBar {...main.props} addFiles={intakeApp} />)
+    const appRoot = app.container.querySelector<HTMLDivElement>('[data-composer-input]')!
+    const mainPicker = vi.spyOn(main.view.container.querySelector<HTMLInputElement>('input[type="file"]')!, 'click')
+    const appPicker = vi.spyOn(app.container.querySelector<HTMLInputElement>('input[type="file"]')!, 'click')
+    onTestFinished(() => { mainPicker.mockRestore(); appPicker.mockRestore() })
+    const file = new File(['test'], 'test.txt', { type: 'text/plain' })
+    const paste = (root: HTMLElement) => fireEvent.paste(root, { clipboardData: {
+      items: [{ kind: 'file', getAsFile: () => file }], getData: () => '',
+    } })
+    act(() => { main.textarea.focus() })
+    paste(main.textarea)
+    expect(intakeMain).toHaveBeenCalledOnce()
+    expect(intakeApp).not.toHaveBeenCalled()
+    expect(main.shell.pickFiles()).toBe(true)
+    expect(mainPicker).toHaveBeenCalledOnce()
+    expect(appPicker).not.toHaveBeenCalled()
+    act(() => { appRoot.focus() })

+      expect(view.container.querySelector('[data-composer-chip]')?.textContent).toBe('会话一')
+      expect(view.container.querySelector('[data-composer-chip] svg')).not.toBeNull()
+    }
+    act(() => { main.textarea.focus(); appRoot.focus() })
+    for (const view of [main.view, app]) expect(view.container.querySelector('[data-composer-chip]')?.textContent).toBe('会话一')
+    expect(main.shell.snapshot.occurrences).toHaveLength(1)

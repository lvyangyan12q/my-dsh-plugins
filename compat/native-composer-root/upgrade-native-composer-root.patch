diff --git a/packages/client/ui-conversation/src/client/input/editor/composer-surfaces.ts b/packages/client/ui-conversation/src/client/input/editor/composer-surfaces.ts
new file mode 100644
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/input/editor/composer-surfaces.ts
@@ -0,0 +1,103 @@
+/** One Session input engine, with read-only Lexical renderers for its other native views. */
+import { $createParagraphNode, $getRoot, createEditor, SKIP_DOM_SELECTION_TAG } from 'lexical'
+import type { LexicalEditor } from 'lexical'
+import { ReferenceChipNode } from './chip-node.tsx'
+import { TextRefNode } from './text-ref.ts'
+
+interface Surface {
+  readonly root: HTMLDivElement
+  readonly mirror: LexicalEditor
+  readonly changed: (editor: LexicalEditor) => void
+  editable: boolean
+}
+
+interface Surfaces {
+  readonly seats: Set<Surface>
+  readonly dispose: () => void
+}
+
+const owners = new WeakMap<LexicalEditor, Surfaces>()
+
+function refresh(editor: LexicalEditor, seats: ReadonlySet<Surface>): void {
+  const root = editor.getRootElement()
+  for (const seat of seats) {
+    if (seat.root === root) {
+      editor.setEditable(seat.editable)
+      seat.changed(editor)
+    } else {
+      if (seat.mirror.getRootElement() !== seat.root) seat.mirror.setRootElement(seat.root)
+      const state = editor.getEditorState().clone(null)
+      if (state.isEmpty()) {
+        seat.mirror.update(() => { $getRoot().clear().append($createParagraphNode()) }, { discrete: true, tag: SKIP_DOM_SELECTION_TAG })
+      } else {
+        seat.mirror.setEditorState(state, { tag: SKIP_DOM_SELECTION_TAG })
+      }
+      seat.changed(seat.mirror)
+    }
+  }
+}
+
+/**
+ * Transfer only the native editing engine to the requested resident surface.
+ * @param editor - authoritative Session editor.
+ * @param root - the surface receiving the user gesture.
+ */
+export function activateDraftSurface(editor: LexicalEditor, root: HTMLElement): void {
+  const owner = owners.get(editor)
+  const seat = owner === undefined ? undefined : [...owner.seats].find(value => value.root === root)
+  if (seat === undefined || editor.getRootElement() === root) return
+  // Detach the display-only renderer before installing the native event engine.
+  seat.mirror.setRootElement(null)
+  editor.setRootElement(root)
+}
+
+/**
+ * Register a native input surface without creating another draft or submit engine.
+ * @param editor - authoritative Session editor.
+ * @param root - resident contenteditable host.
+ * @param editable - this view's editing permission.
+ * @param changed - select the editor used for this view's decorator portals.
+ * @returns view-local permission update and cleanup operations.
+ */
+export function registerDraftSurface(
+  editor: LexicalEditor,
+  root: HTMLDivElement,
+  editable: boolean,
+  changed: (editor: LexicalEditor) => void,
+): { setEditable(value: boolean): void; dispose(): void } {
+  let owner = owners.get(editor)
+  if (owner === undefined) {
+    const seats = new Set<Surface>()
+    const offRoot = editor.registerRootListener(() => { refresh(editor, seats) })
+    const offUpdate = editor.registerUpdateListener(() => { refresh(editor, seats) })
+    owner = { seats, dispose: () => { offRoot(); offUpdate() } }
+    owners.set(editor, owner)
+  }
+  const seat: Surface = {
+    root, editable, changed,
+    mirror: createEditor({
+      namespace: 'dsh-composer-display', nodes: [ReferenceChipNode, TextRefNode],
+      editable: false, disableEvents: true, onError: error => { throw error },
+    }),
+  }
+  owner.seats.add(seat)
+  const activeRoot = editor.getRootElement()
+  if (activeRoot !== null && activeRoot.contains(root.ownerDocument.activeElement)) refresh(editor, owner.seats)
+  else activateDraftSurface(editor, root)
+  const currentOwner = owner
+  return {
+    setEditable(value) {
+      seat.editable = value
+      if (editor.getRootElement() === root) editor.setEditable(value)
+    },
+    dispose() {
+      currentOwner.seats.delete(seat)
+      seat.mirror.setRootElement(null)
+      if (editor.getRootElement() === root) editor.setRootElement(null)
+      if (currentOwner.seats.size === 0) {
+        currentOwner.dispose()
+        owners.delete(editor)
+      }
+    },
+  }
+}

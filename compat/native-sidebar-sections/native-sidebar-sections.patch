@@ -56,0 +57,15 @@ describe('sidebar shell snapshots', () => {
+  it('composes independent plugin sections without replacing the native foot', async () => {
+    const {runtime} = await bench({locale:'en'})
+    const section = runtime.ctx.slots.register({name:'sidebar.sections',id:'fixture-extension'}, ({wide}) => <nav aria-label="Fixture extension" data-wide={wide}>Fixture section</nav>)
+    const footer = runtime.ctx.slots.register({name:'sidebar.footer.action',id:'fixture-native-footer'}, ({wide}) => <button data-wide={wide}>Fixture footer</button>)
+    try{
+      const slot = runtime.renderSlot('sidebar',{collapsed:false,width:300})
+      const nativeButton=slot.view.getAllByRole('button',{name:'New session'})[0], footerButton=slot.view.getByRole('button',{name:'Fixture footer'})
+      expect(slot.container).toMatchSnapshot()
+      expect(slot.view.getByRole('navigation',{name:'Fixture extension'}).getAttribute('data-wide')).toBe('true')
+      await act(async () => {section()})
+      await waitFor(() => expect(slot.view.queryByRole('navigation',{name:'Fixture extension'})).toBeNull())
+      expect(slot.view.getByRole('button',{name:'Fixture footer'})).toBe(footerButton)
+      expect(slot.view.getAllByRole('button',{name:'New session'})[0]).toBe(nativeButton)
+    }finally{section();footer();await runtime.dispose()}
+  })

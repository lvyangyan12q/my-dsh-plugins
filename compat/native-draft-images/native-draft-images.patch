+  /** Stage only image drafts on an already mounted Session; never start an upload or prompt. */
+  stageImages(sessionId: SessionId, files: readonly File[]): () => void {
+    const scope = this.ctx.sessions.scope(sessionId)
+    if (scope === undefined) throw new Error('conversation: target Session input unavailable')
+    if (files.length === 0 || files.some(file => !isImageMediaType(file.type))) throw new Error('conversation: image files required')
+    const input = this.input.for(scope)
+    if (!['plain', 'claimed'].includes(input.state.getSnapshot().phase)) throw new Error('conversation: target draft is busy')
+    const drafts = this.createDrafts(sessionId, files)
+    if (!input.addAttachments(drafts.map(draft => draft.id))) {
+      this.releaseDraftAttachments(drafts)
+      throw new Error('conversation: target draft refused images')
+    }
+    let released = false
+    return () => {
+      if (released) return
+      released = true
+      for (const draft of drafts) {
+        if (input.removeAttachment(draft.id)) this.releaseDraftAttachment(draft.id)
+      }
+    }
+  }

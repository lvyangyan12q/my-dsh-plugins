+
+/** Non-destructive inspection for explicit retirement and saved inventory. */
+export type SidebarLayoutInspection = {
+  readonly outcome: 'ready'
+  readonly surface: SurfaceState
+} | {
+  readonly outcome: 'not-found' | 'persistence-unavailable' | 'unsupported-snapshot'
+}
+/**
+ * Inspect a saved scope without deleting unsupported data.
+ * @param sessionId - exact storage scope.
+ * @returns validated state without deleting unsupported data.
+ */
+export function inspectSidebarLayout(sessionId: string): SidebarLayoutInspection {
+  if (typeof localStorage === 'undefined')
+    return { outcome: 'persistence-unavailable' }
+  let raw: string | null
+  try {
+    raw = localStorage.getItem(sidebarPersistence + '.' + sessionId)
+  }
+  catch (_unavailable) {
+    return { outcome: 'persistence-unavailable' }
+  }
+  if (raw === null)
+    return { outcome: 'not-found' }
+  try {
+    const data = envelope.strict().parse(JSON.parse(raw))
+    if (Object.keys(data.bySession).length !== 1 || data.bySession[sessionId] === undefined)
+      return { outcome: 'unsupported-snapshot' }
+    const parsed = surface.strict().parse(data.bySession[sessionId])
+    validateReferences(parsed)
+    if (!sameSavedFields(data.bySession[sessionId], parsed))
+      return { outcome: 'unsupported-snapshot' }
+    return { outcome: 'ready', surface: { layout: restoreLayout(parsed.layout), minted: parsed.minted, history: EMPTY_HISTORY } }
+  }
+  catch (_unsupported) {
+    return { outcome: 'unsupported-snapshot' }
+  }
+}
+/**
+ * Enumerate native saved scopes without mounting their content.
+ * @returns saved Session scopes, or undefined if storage cannot be enumerated.
+ */
+export function savedSidebarSessions(): readonly string[] | undefined {
+  if (typeof localStorage === 'undefined')
+    return undefined
+  try {
+    return Array.from({ length: localStorage.length }, (_, index) => localStorage.key(index)).filter((key): key is string => key !== null && key.startsWith(sidebarPersistence + '.')).map(key => key.slice(sidebarPersistence.length + 1))
+  }
+  catch (_unavailable) {
+    return undefined
+  }
+}
+/**
+ * Verify persistence before certifying a durable retirement.
+ * @param sessionId - scope to commit.
+ * @param value - complete surface.
+ * @returns true only after successful save and exact read-back; failure attempts to restore prior bytes.
+ */
+export function writeSidebarLayoutVerified(sessionId: string, value: SurfaceState): boolean {
+  if (typeof localStorage === 'undefined')
+    return false
+  const key = sidebarPersistence + '.' + sessionId
+  let previous: string | null
+  try {
+    previous = localStorage.getItem(key)
+  }
+  catch (_unavailable) {
+    return false
+  }
+  const encoded = JSON.stringify({ bySession: { [sessionId]: { layout: value.layout, minted: value.minted } } })
+  try {
+    localStorage.setItem(key, encoded)
+    if (localStorage.getItem(key) === encoded)
+      return true
+  }
+  catch (_unavailable) { /* Failed writes cannot certify retirement. */ }
+  try {
+    if (previous === null)
+      localStorage.removeItem(key)
+    else
+      localStorage.setItem(key, previous)
+  }
+  catch (_rollbackUnavailable) { /* The caller reports unavailable rather than removed. */ }
+  return false
+}
+/** Parsed keys must account for every persisted field, including future nested fields. */
+function sameSavedFields(raw: unknown, parsed: unknown): boolean {
+  if (raw === null || parsed === null || typeof raw !== 'object' || typeof parsed !== 'object')
+    return true
+  const input = raw as Record<string, unknown>, known = parsed as Record<string, unknown>
+  return Object.keys(input).length === Object.keys(known).length
+    && Object.keys(input).every(key => Object.hasOwn(known, key) && sameSavedFields(input[key], known[key]))
+}
+
+/** Restore validated identifiers and the kit's explicit optional pane fields. */
+function restoreLayout(value: z.infer<typeof layout>): LayoutState {
+  const nodes: Record<NodeId, LayoutNode> = {}
+  for (const [id, entry] of Object.entries(value.nodes)) {
+    nodes[id as NodeId] = entry.kind === 'pane'
+      ? {
+        ...entry, id: entry.id as PaneId, tabs: entry.tabs.map(id => id as TabId),
+        activeTabId: entry.activeTabId as TabId | undefined, rect: entry.rect,
+      }
+      : { ...entry, id: entry.id as SplitId, children: entry.children.map(id => id as NodeId) }
+  }
+  const tabs: Record<TabId, TabRecord> = {}
+  for (const [id, tab] of Object.entries(value.tabs)) tabs[id as TabId] = { ...tab, id: tab.id as TabId }
+  return {
+    ...value, nodes, tabs, rootId: value.rootId as NodeId,
+    floats: value.floats.map(id => id as PaneId), activePaneId: value.activePaneId as PaneId,
+  }
+}

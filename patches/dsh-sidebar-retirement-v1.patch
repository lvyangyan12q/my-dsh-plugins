+  const store = createSidebarRightStore(seed).create(session)
+  store.actions.openContent(session, { kind: 'owned', contentId: 'owned-page', title: 'Owned' }, () => { })
+  store.actions.openContent(session, { kind: 'file', contentId: 'file-a', title: 'File' }, () => { })
+  const old = store.getSnapshot().bySession[session]!, file = Object.values(old.layout.tabs).find(tab => tab.kind === 'file')!
+  const f = setup()
+  try {
+    expect(f.controller.retireTabsByKind('owned').records).toContainEqual(expect.objectContaining({ sessionId: session, outcome: 'removed' }))
+    const restored = createSidebarRightStore(seed).create(session).getSnapshot().bySession[session]!
+    expect(Object.values(restored.layout.tabs)).toEqual([file])
+    expect(restored.minted).toBe(old.minted)

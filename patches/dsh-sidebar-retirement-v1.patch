+const seed = () => ({ kind: 'guide', title: 'Guide' })
+afterEach(() => { localStorage.clear(); vi.restoreAllMocks() })
+function setup() {
+  const ctx = new Context(), tabs = new SidebarRightTabRegistry(ctx)
+  const unregisterOwned = tabs.register({ id: 'owned', kind: 'owned', title: () => 'Owned' })
+  const controls = createSidebarRightController(tabs, vi.fn(), {
+    autoFullscreen: () => false,
+    openWithFocus: () => { throw Error('No navigation') },
+    closeWithFocus: (_id, _pane, close) => close(),

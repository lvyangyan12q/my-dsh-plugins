{
  "name": "dsh-paper-reader",
  "description": "DSH 论文与博客中英文对照阅读器：侧栏按天聚合列表，主面板三模式阅读",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-alpha.2"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "sample/digest.json",
    "README.md",
    "docs/DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node test/host.test.mjs && node test/storage.test.mjs && node test/client.test.mjs && node test/history.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:storage": "node test/storage.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:history": "node test/history.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}

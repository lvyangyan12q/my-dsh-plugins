{
  "name": "dsh-paper-reader",
  "description": "DSH 论文与博客中英文对照阅读器：侧栏按天聚合列表，主面板三模式阅读",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "paper-reader": "./scripts/paper-reader.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-alpha.2"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "scripts/paper-reader.mjs",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "sample/digest.json",
    "README.md",
    "docs/DESIGN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check scripts/paper-reader.mjs",
    "digest": "node scripts/paper-reader.mjs",
    "test": "node test/host.test.mjs && node test/storage.test.mjs && node test/client.test.mjs && node test/history.test.mjs && node test/arxiv.test.mjs && node test/deepseek.test.mjs && node test/hf.test.mjs && node test/selection.test.mjs && node test/translation.test.mjs && node test/proxy.test.mjs && node test/pipeline.test.mjs && node test/cli.test.mjs && node test/proxy-page.test.mjs && node test/openai.test.mjs && node test/openai-page.test.mjs && node test/e2e.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:storage": "node test/storage.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:history": "node test/history.test.mjs",
    "test:arxiv": "node test/arxiv.test.mjs",
    "test:deepseek": "node test/deepseek.test.mjs",
    "test:hf": "node test/hf.test.mjs",
    "test:selection": "node test/selection.test.mjs",
    "test:proxy": "node test/proxy.test.mjs",
    "test:proxy-page": "node test/proxy-page.test.mjs",
    "test:openai": "node test/openai.test.mjs",
    "test:openai-page": "node test/openai-page.test.mjs",
    "test:pipeline": "node test/pipeline.test.mjs",
    "test:cli": "node test/cli.test.mjs",
    "test:translation": "node test/translation.test.mjs",
    "test:e2e": "node test/e2e.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
